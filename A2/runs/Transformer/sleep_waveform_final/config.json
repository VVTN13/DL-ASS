{
  "model_name": "Transformer",
  "model_kwargs": {
    "in_channels": 2,
    "num_classes": 5,
    "emb_dim": 128,
    "num_heads": 4,
    "num_layers": 3,
    "mlp_ratio": 3,
    "dropout": 0.1
  },
  "data_path": "dataset/sleep_waveform.pt",
  "seed": 42,
  "lr": 3e-05,
  "batch_size": 64,
  "weight_decay": 0.0001,
  "n_splits": 5,
  "max_epochs": 80,
  "scheduler_name": "CosineAnnealingLR",
  "scheduler_kwargs": {
    "T_max": 80,
    "eta_min": 1e-06
  },
  "num_workers": 4,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "pin_memory": true,
  "optimizer": "Adam",
  "amsgrad": true,
  "selection_metric": "validation macro-F1",
  "early_stopping_patience": 10,
  "early_stopping_min_delta": 0.001,
  "amp": true,
  "fold_policy": "saved participant validation_folds; test excluded"
}
