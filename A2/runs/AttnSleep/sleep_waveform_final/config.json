{
  "config_file": "configs/AttnSleep.json",
  "model_name": "AttnSleep",
  "model_kwargs": {
    "channel_index": 0
  },
  "data_path": "dataset/sleep_waveform.pt",
  "seed": 42,
  "lr": 0.001,
  "batch_size": 128,
  "weight_decay": 0.001,
  "n_splits": 5,
  "max_epochs": 80,
  "num_workers": 4,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "pin_memory": true,
  "optimizer": "Adam",
  "amsgrad": true,
  "scheduler_name": "MultiStepLR",
  "scheduler_kwargs": {
    "milestones": [
      10
    ],
    "gamma": 0.1
  },
  "loss": "weighted CrossEntropyLoss",
  "class_weight_mu": [
    0.3,
    0.4,
    0.3,
    0.2,
    0.3
  ],
  "selection_metric": "validation macro-F1",
  "early_stopping_patience": 10,
  "early_stopping_min_delta": 0.001,
  "amp": true,
  "fold_policy": "saved participant validation_folds; test excluded"
}
