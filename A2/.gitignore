# Local Python environments
.venv/
venv/

# Downloaded datasets and generated caches
data/
dataset/sleep_cbramod*/
dataset/sleep_waveform*.pt
dataset/.sleep_waveform-*/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS and editor files
.DS_Store
.idea/
