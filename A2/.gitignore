# Local logs and temporary files
*.log
tmp/
# Fixed run per model/dataset. Version small results; keep trained weights local.
/runs/*
!/runs/README.md
!/runs/StandardCNN2D/
!/runs/Transformer/
!/runs/AttnSleep/
!/runs/CBraModClassifier/
/runs/*/*
!/runs/*/*_final/
