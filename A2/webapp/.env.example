# Copy to .env to override the Docker Compose defaults. None of these are required locally.

# Port of the web app on the host.
WEB_PORT=8080
# PostgreSQL is published on 127.0.0.1 only, for running the backend tests from the host.
DB_PORT=5432
POSTGRES_PASSWORD=sleep

# Directory holding <release>/manifest.json and fold_*.pt (see README, "Checkpoints").
CHECKPOINTS_DIR=./backend/checkpoints

# Uploads are open to every visitor: they are deleted after this many days (0 = never).
RETENTION_DAYS=30
# CPU threads used by one inference job.
TORCH_THREADS=4
