              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Job Predictions",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "Model releases that can be run, with the metrics published in the A2 report.",
        "operationId": "models-list_models",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelPublic"
                  },
                  "title": "Response Models-List Models",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/v1/recordings": {
      "get": {
        "description": "Every recording, samples first, then newest uploads.",
        "operationId": "recordings-list_recordings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingsPublic"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Recordings",
        "tags": [
          "recordings"
        ]
      },
      "post": {
        "description": "Upload a recording, optionally with its hypnogram, and queue the selected models.\n\nUploading the same file again returns the existing recording and only queues models\nthat have not been run on it yet.",
        "operationId": "recordings-create_recording",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_recordings-create_recording"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "This file was uploaded before; it is reused."
          },
          "201": {
            "content": {
