{
  "model_name": "CBraModClassifier",
  "model_kwargs": {
    "in_channels": 2,
    "checkpoint_path": "pretrained_weights/pretrained_weights.pth",
    "freeze_encoder": false,
    "num_classes": 5,
    "dropout": 0.5
  },
  "data_path": "dataset/sleep_waveform.pt",
  "seed": 42,
  "lr": 3e-05,
  "batch_size": 128,
  "weight_decay": 0.0001,
  "n_splits": 5,
  "max_epochs": 80,
  "scheduler_name": "CosineAnnealingLR",
  "scheduler_kwargs": {
    "T_max": 80,
    "eta_min": 1e-06
  },
  "num_workers": 4,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "pin_memory": true
}
