{
  "model_name": "AttnSleep",
  "model_kwargs": {
    "channel_index": 0
  },
  "data_path": "dataset/sleep_waveform.pt",
  "seed": 42,
  "lr": 0.001,
  "batch_size": 128,
  "weight_decay": 0.001,
  "n_splits": 5,
  "max_epochs": 80,
  "scheduler_name": "MultiStepLR",
  "scheduler_kwargs": {
    "milestones": [
      10
    ],
    "gamma": 0.1
  },
  "num_workers": 4,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "pin_memory": true
}
